# Copy to local.properties. Every value here is read into BuildConfig at build time.
# Nothing in this file may be committed.
sdk.dir=/home/you/Android/Sdk

# Routing (Valhalla /route endpoint) and geocoding (Photon /api/)
valhallaUrl=https://your-valhalla.example:8446/route
photonUrl=https://photon.komoot.io/api/

# Map style served by the in-app loopback server from the app's files dir
styleUrl=http://127.0.0.1:8781/style-light.json

# Venus OS (Victron) MQTT broker on the truck network, and its VRM portal id
venusHost=192.168.1.50
venusPortalId=0123456789ab

# Audiobookshelf
absUrl=https://your-abs.example
absUser=driver
absPass=change-me

# Fallback map position before the first GPS fix (defaults to Denton, TX)
homeLat=33.2148
homeLng=-97.1331
